  "timeline": {
    "name": "Get Timeline Entries",
    "url": "https://api.devrev.ai/timeline-entries.list",
    "jsonBody": "={\n  \"object\": \"{{ $('Get tickets from DevRev1').first().json.work.id }}\",\n  \"visibility\": [\"external\"],\n  \"limit\": 100,\n  \"mode\": \"after\"\n}",
    "options": {
      "pagination": {
        "pagination": {
          "parameters": {
            "parameters": [
              {
                "type": "body",
                "name": "cursor",
                "value": "={{ $response.body.next_cursor }}"
              }
            ]
          },
          "paginationCompleteWhen": "other",
          "completeExpression": "={{ !$response.body.next_cursor }}",
          "limitPagesFetched": true,
          "maxRequests": 10
        }
      }
    }
  },
  "publication_authorizes_participant_messages": false
}
