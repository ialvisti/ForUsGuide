FROM python:3.12-slim@sha256:64695412729fbe8cf054511723820c82bbe5a077d4a6b4070cd4a7225d3422ce

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY requirements.lock requirements-dev.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-dev.lock
RUN useradd --create-home --uid 1000 appuser

COPY --chown=appuser:appuser api/ ./api/
COPY --chown=appuser:appuser data_pipeline/ ./data_pipeline/
COPY --chown=appuser:appuser scripts/ ./scripts/
COPY --chown=appuser:appuser tests/ ./tests/
COPY --chown=appuser:appuser rag-testing/ ./rag-testing/
COPY --chown=appuser:appuser ui/ ./ui/
COPY --chown=appuser:appuser pyproject.toml pytest.ini .secrets.baseline ./

USER 1000
ENTRYPOINT ["python", "-m", "pytest"]
