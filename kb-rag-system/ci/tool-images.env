# Imágenes-herramienta fijadas por digest inmutable (plan Tarea 3).
# Resueltas el 2026-07-14 contra los registries públicos (read-only).
# Regla: ninguna referencia mutable (:latest / tag sin @sha256:) en CI.

# Base de runtime y de compilación de locks (Docker Hub, manifest list).
PYTHON_BASE_IMAGE=python:3.12-slim@sha256:64695412729fbe8cf054511723820c82bbe5a077d4a6b4070cd4a7225d3422ce

# Emulador de Firestore (gcr.io público). PENDIENTE-CLOUD-BUILD: la revisión
# del componente (gcloud components list --filter='id:cloud-firestore-emulator
# AND state.name:Installed') debe ejecutarse en Cloud Build antes de usar el
# emulador como gate (la sesión gcloud local expiró el 2026-07-14; ver
# docs/verification/handle-ticket/03-image-and-locks.md).
FIRESTORE_EMULATOR_IMAGE=gcr.io/google.com/cloudsdktool/google-cloud-cli:emulators@sha256:38132a268745db5a1dc2ebfecfe6f935d75de281dddc6922f0fe3780c5552b81

# Generador de SBOM (Tarea 12 Paso 1.9), fijado por versión + digest.
SYFT_IMAGE=anchore/syft:v1.46.0@sha256:473a60e3a58e29aca3aedb3e99e787bb4ef273917e44d10fcbea4330a07320bb
