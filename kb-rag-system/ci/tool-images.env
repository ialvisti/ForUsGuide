# Imágenes-herramienta fijadas por digest inmutable (plan Tarea 3).
# Resueltas el 2026-07-14 contra los registries públicos (read-only).
# Regla: ninguna referencia mutable (:latest / tag sin @sha256:) en CI.

# Base de CI/compilación de locks (Docker Hub, manifest list).
PYTHON_BASE_IMAGE=python:3.12-slim@sha256:64695412729fbe8cf054511723820c82bbe5a077d4a6b4070cd4a7225d3422ce

# El runtime se construye con Python 3.12 sobre Debian 12 y termina sobre
# Distroless Debian 12 nonroot. Separar builder/runtime elimina herramientas y
# paquetes del SO (incluido Perl) que la aplicación no usa. Pins resueltos
# read-only contra Docker Hub/GCR el 2026-07-27.
PYTHON_RUNTIME_BUILDER_IMAGE=python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b
PYTHON_DISTROLESS_RUNTIME_IMAGE=gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5

# Google Cloud CLI general y emulador de Firestore usan artefactos distintos.
# Ambos pins incluyen la versión publicada y el digest del índice multi-arch.
GOOGLE_CLOUD_CLI_IMAGE=gcr.io/google.com/cloudsdktool/google-cloud-cli:577.0.0@sha256:1ccec754a72b81280b047f476e92771afbef26b3072f3798937fc39101f7a60a

# Emulador de Firestore (gcr.io público). PENDIENTE-CLOUD-BUILD: la revisión
# del componente (gcloud components list --filter='id:cloud-firestore-emulator
# AND state.name:Installed') debe ejecutarse en Cloud Build antes de usar el
# emulador como gate (la sesión gcloud local expiró el 2026-07-14; ver
# docs/verification/handle-ticket/03-image-and-locks.md).
FIRESTORE_EMULATOR_IMAGE=gcr.io/google.com/cloudsdktool/google-cloud-cli:577.0.0-emulators@sha256:6e91e97e42d58ed28a42e1c660f0495fd7138eb48099daa4881ce8452947f651

# Generador de SBOM (Tarea 12 Paso 1.9), fijado por versión + digest.
SYFT_IMAGE=anchore/syft:v1.46.0@sha256:473a60e3a58e29aca3aedb3e99e787bb4ef273917e44d10fcbea4330a07320bb
