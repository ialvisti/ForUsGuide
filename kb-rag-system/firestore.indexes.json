{
  "__comment": "Índices y TTL del flujo de tickets. La fuente autoritativa de despliegue es infra/terraform/modules/ticket_environment/firestore.tf y este espejo canónico conserva las mismas consultas. El outbox y el journal RAG sólo reciben expires_at cuando llegan a un estado terminal; pending, retry, dead_letter y started no expiran. La consola /tickets usa bases nombradas aisladas y una retención explícita para reviews, evaluaciones y lotes; no existe ninguna colección de importación o exportación de archivos.",
  "indexes": [
    {
      "collectionGroup": "ticket_jobs",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "principal_id", "order": "ASCENDING"},
        {"fieldPath": "state", "order": "ASCENDING"}
      ]
    },
    {
      "collectionGroup": "ticket_jobs",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "state", "order": "ASCENDING"},
        {"fieldPath": "lease_expires_at", "order": "ASCENDING"}
      ],
      "__comment": "reconciliador: leases vencidos por estado (running + lease_expires_at < now)"
    },
    {
      "collectionGroup": "ticket_jobs",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "state", "order": "ASCENDING"},
        {"fieldPath": "created_at", "order": "ASCENDING"}
      ],
      "__comment": "observabilidad: count queued/running y job activo más antiguo"
    },
    {
      "collectionGroup": "ticket_jobs",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "enqueue_state", "order": "ASCENDING"},
        {"fieldPath": "created_at", "order": "ASCENDING"}
      ],
      "__comment": "reconciliador: outbox pending en orden FIFO acotado"
    },
    {
      "collectionGroup": "ticket_evaluation_outbox",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "state", "order": "ASCENDING"},
        {"fieldPath": "next_attempt_at", "order": "ASCENDING"},
        {"fieldPath": "__name__", "order": "ASCENDING"}
      ],
      "__comment": "publisher: retries vencidos sin que un retry futuro oculte uno ya debido"
    },
    {
      "collectionGroup": "ticket_rag_invocations",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "state", "order": "ASCENDING"},
        {"fieldPath": "next_recovery_at", "order": "ASCENDING"},
        {"fieldPath": "__name__", "order": "ASCENDING"}
      ],
      "__comment": "reconciliador: intents RAG started cuyo plazo de recuperación ya venció"
    },
    {
      "collectionGroup": "ticket_reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "status", "order": "ASCENDING"},
        {"fieldPath": "updated_at", "order": "DESCENDING"},
        {"fieldPath": "review_id", "order": "ASCENDING"}
      ],
      "__comment": "consola /tickets: cola por estado con desempate estable (updated_at DESC, review_id ASC)"
    },
    {
      "collectionGroup": "ticket_reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "status", "order": "ASCENDING"},
        {"fieldPath": "assigned_reviewer.email", "order": "ASCENDING"},
        {"fieldPath": "updated_at", "order": "DESCENDING"},
        {"fieldPath": "review_id", "order": "ASCENDING"}
      ],
      "__comment": "consola /tickets: cola por revisor asignado (una sola faceta)"
    },
    {
      "collectionGroup": "ticket_reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "status", "order": "ASCENDING"},
        {"fieldPath": "observation_type", "order": "ASCENDING"},
        {"fieldPath": "updated_at", "order": "DESCENDING"},
        {"fieldPath": "review_id", "order": "ASCENDING"}
      ],
      "__comment": "consola /tickets: cola por taxonomía de causa raíz (una sola faceta)"
    },
    {
      "collectionGroup": "ticket_reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "status", "order": "ASCENDING"},
        {"fieldPath": "rating", "order": "ASCENDING"},
        {"fieldPath": "updated_at", "order": "DESCENDING"},
        {"fieldPath": "review_id", "order": "ASCENDING"}
      ],
      "__comment": "consola /tickets: cola por rating heredado (1-5) (una sola faceta)"
    },
    {
      "collectionGroup": "ticket_reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "status", "order": "ASCENDING"},
        {"fieldPath": "remediation_target", "order": "ASCENDING"},
        {"fieldPath": "updated_at", "order": "DESCENDING"},
        {"fieldPath": "review_id", "order": "ASCENDING"}
      ],
      "__comment": "consola /tickets: cola por objetivo de remediación (una sola faceta)"
    },
    {
      "collectionGroup": "ticket_reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "status", "order": "ASCENDING"},
        {"fieldPath": "severity", "order": "ASCENDING"},
        {"fieldPath": "updated_at", "order": "DESCENDING"},
        {"fieldPath": "review_id", "order": "ASCENDING"}
      ],
      "__comment": "consola /tickets: cola por severidad (una sola faceta)"
    },
    {
      "collectionGroup": "ticket_reviews",
      "queryScope": "COLLECTION",
      "fields": [
        {"fieldPath": "status", "order": "ASCENDING"},
        {"fieldPath": "topic", "order": "ASCENDING"},
        {"fieldPath": "updated_at", "order": "DESCENDING"},
        {"fieldPath": "review_id", "order": "ASCENDING"}
      ],
      "__comment": "consola /tickets: cola por tema (una sola faceta)"
    }
  ],
  "fieldOverrides": [
    {
      "collectionGroup": "ticket_job_payloads",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "fail-safe de privacidad: PII expira a 24h de la aceptación"
    },
    {
      "collectionGroup": "ticket_jobs",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "SÓLO terminales llevan expires_at (retención = TICKET_IDEMPOTENCY_RETENTION_DAYS); un control no terminal no tiene TTL"
    },
    {
      "collectionGroup": "ticket_idempotency_receipts",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "receipts expiran JUNTO con su control/tombstone (>=90d)"
    },
    {
      "collectionGroup": "ticket_rate_windows",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "ventanas de tasa: TTL 48h, posterior al horizonte de retry/replay"
    },
    {
      "collectionGroup": "ticket_executions",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "checkpoints sanitizados de ejecución de tickets"
    },
    {
      "collectionGroup": "execution_logs",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "logs estructurados core con retención declarativa"
    },
    {
      "collectionGroup": "ticket_evaluation_outbox",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "sólo delivery acknowledged lleva expires_at; pending/retry/dead_letter no expiran"
    },
    {
      "collectionGroup": "ticket_rag_invocations",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "sólo completed/recovered lleva expires_at; started conserva el intent hasta resolverlo"
    },
    {
      "collectionGroup": "devrev_message_cache",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "cuerpos de mensaje DevRev: TTL 24h; único lugar con body/título"
    },
    {
      "collectionGroup": "idempotency_keys",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "receipts de idempotencia de la consola: TTL 7d"
    },
    {
      "collectionGroup": "ticket_console_cache",
      "fieldPath": "expires_at",
      "ttl": true,
      "__comment": "cache de listado/detalle: TTL 15 min (nunca retención de review)"
    }
  ]
}
